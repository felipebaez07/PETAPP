# Copia a .env.local (Expo carga .env* automáticamente) una vez el proyecto
# Supabase real exista — ver docs/NEXT_STEPS.md en la raíz del monorepo.
# Sin estas variables, la app funciona en modo demo con datos de ejemplo de
# @petapp/shared (directorio, adopciones y mascotas navegables, sin backend
# real ni autenticación funcional).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
