# Copia a .env.local (Expo carga .env* automáticamente) una vez el proyecto
# Supabase real exista — ver docs/NEXT_STEPS.md en la raíz del monorepo.
# Sin estas variables, la app funciona en modo demo con datos de ejemplo de
# @petapp/shared (directorio, calendario preventivo y mascotas navegables, sin
# backend real ni autenticación funcional).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL de la web desplegada en Vercel — mobile llama sus Route Handlers (ej. el chat de
# pre-diagnóstico con IA en /api/ai/prediagnostico) porque ahí vive la API key de Gemini,
# nunca en el bundle de la app.
EXPO_PUBLIC_WEB_URL=
